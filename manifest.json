{
  "manifest_version": 3,
  "name": "Gmail AI Quick Reply",
  "version": "1.3",
  "description": "Generate smart one-click replies for Gmail using AI. Verify subscription in popup.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
