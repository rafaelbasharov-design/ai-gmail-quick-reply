{
  "manifest_version": 3,
  "name": "Gmail AI Quick Reply",
  "version": "1.3",
  "description": "Generate smart one-click replies for Gmail using AI. Verify Gumroad subscription in popup.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://api.gumroad.com/*",
    "https://gmail-ai-server.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
